<%= form_with(model: photo, local: true) do |form| %>
  <% if photo.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(photo.errors.count, "error") %> prohibited this photo from being saved:</h4>
      <ul>
        <% photo.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :image, class: "form-label" %>
    <%= form.text_field :image, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :caption, class: "form-label" %>
    <%= form.text_area :caption, class: "form-control" %>
  </div>

  <%= form.submit "Create Photo", class: "btn btn-primary" %>
<% end %>
