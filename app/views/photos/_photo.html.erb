<!-- app/views/photos/_photo.html.erb -->
<div class="card mb-4">
  <%= image_tag photo.image_url, class: "card-img-top" %>
  <div class="card-body">
    <h5><%= photo.owner.username %></h5>
    <p><%= photo.caption %></p>
  </div>

  <ul class="list-group list-group-flush">
    <% photo.comments.each do |comment| %>
      <li class="list-group-item">
        <div class="d-flex">
          <%= image_tag comment.author.avatar_image_url, class: "rounded-circle me-2", width: 32 %>
          <div>
            <strong><%= comment.author.username %></strong>
            <%= comment.body %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>

  <div class="card-body">
    <%= render "comments/form", comment: photo.comments.build %>
  </div>
</div>
