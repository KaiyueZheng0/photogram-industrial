<h1><%= @user.username %>'s Feed</h1>

<% @feed_photos.each do |photo| %>
  <div class="card mb-3">
    <div class="card-body">
      <p><strong><%= photo.owner.username %></strong></p>
      <img src="<%= photo.image %>" class="img-fluid mb-2" />
      <p><%= photo.caption %></p>
    </div>
  </div>
<% end %>
